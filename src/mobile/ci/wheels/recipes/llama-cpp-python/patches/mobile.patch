+def _copy_skeletons(skeletons: dict, skel_dir) -> tuple:
+    """Copy each packaged libggml-htp-vNN.so.dsp to skel_dir/libggml-htp-vNN.so when missing or different:
+    (copied, unchanged)."""
+    target = pathlib.Path(skel_dir)
+    target.mkdir(parents=True, exist_ok=True)
+    copied = unchanged = 0
+    for arch in sorted(skeletons):
+        data = skeletons[arch].read_bytes()
+        dest = target / f"{HTP_PREFIX}{arch}.so"
+        try:
+            same = dest.is_file() and dest.stat().st_size == len(data) and dest.read_bytes() == data
+        except OSError:
+            same = False
+        if same:
+            unchanged += 1
+            continue
+        part = target / f".{dest.name}.part"
+        part.write_bytes(data)
+        os.replace(part, dest)
+        copied += 1
+    return copied, unchanged
+
