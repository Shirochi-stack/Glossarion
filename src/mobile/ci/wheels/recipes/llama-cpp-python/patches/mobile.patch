diff --git a/vendor/llama.cpp/ggml/src/ggml-hexagon/ggml-hexagon.cpp b/vendor/llama.cpp/ggml/src/ggml-hexagon/ggml-hexagon.cpp
index f9daf10..64b1d5d 100644
--- a/vendor/llama.cpp/ggml/src/ggml-hexagon/ggml-hexagon.cpp
+++ b/vendor/llama.cpp/ggml/src/ggml-hexagon/ggml-hexagon.cpp
@@ -3883,3 +3883,44 @@ ggml_backend_reg_t ggml_backend_hexagon_reg(void) {
 }
 
 GGML_BACKEND_DL_IMPL(ggml_backend_hexagon_reg)
+
+// Glossarion: the session check of the app's NPU probe (llama_cpp._ctypes_extensions.register_npu_backend).
+// Sessions open lazily, so a cDSP that refuses the app's unsigned PD only shows when a backend starts.
+// ggml_backend_dev_init() runs ggml_backend_hexagon_device_init(), which opens the device's real session
+// (ggml_hexagon_session::allocate: remote_session_control, unsigned PD, htp_iface open, dspqueue, iface
+// start) and throws std::runtime_error when the DSP refuses. A C++ exception must not cross the C ABI
+// into ctypes (std::terminate), so it is caught here and its text returned. The backend is freed again;
+// the session itself stays with the registry (upstream frees sessions only with it) and the model load
+// reuses it. Returns 0 when the session opened, -1 otherwise (``err`` says why).
+extern "C" {
+GGML_BACKEND_API int glossarion_hexagon_session_check(size_t index, char * err, size_t err_len);
+}
+
+int glossarion_hexagon_session_check(size_t index, char * err, size_t err_len) {
+    auto fail = [&](const char * why) {
+        if (err && err_len) {
+            snprintf(err, err_len, "%s", why);
+        }
+        return -1;
+    };
+    ggml_backend_reg_t reg = ggml_backend_hexagon_reg();
+    if (!reg) {
+        return fail("the Hexagon registry did not start");
+    }
+    ggml_backend_dev_t dev = ggml_backend_reg_dev_get(reg, index);
+    if (!dev) {
+        return fail("no such HTP device");
+    }
+    try {
+        ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+        if (!backend) {
+            return fail("ggml_backend_dev_init returned NULL");
+        }
+        ggml_backend_free(backend);
+    } catch (const std::exception & exc) {
+        return fail(exc.what());
+    } catch (...) {
+        return fail("unknown C++ exception while opening the session");
+    }
+    return 0;
+}
