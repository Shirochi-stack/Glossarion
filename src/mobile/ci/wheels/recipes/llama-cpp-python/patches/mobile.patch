+        _npu_step(state, "registry", False, "the engine's libraries are not loaded")
+        return
+    reg, path, why = _load_backend(NPU_LIBRARY)
+    if not reg:
+        _npu_step(state, "registry", False, f"the Hexagon backend did not load ({why})" if why
+                  else "the Hexagon backend did not start (ggml_backend_init returned NULL: see the ggml-hex log)")
+        return
+    count = int(_ggml("ggml_backend_reg_dev_count", ctypes.c_size_t, [ctypes.c_void_p])(reg))
+    dev = _ggml("ggml_backend_reg_dev_get", ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_size_t])(reg, 0) if count \
+        else None
+    name = (_ggml("ggml_backend_dev_name", ctypes.c_char_p, [ctypes.c_void_p])(dev) or b"").decode("utf-8", "replace") \
+        if dev else ""
+    note = f"; ignored options {ignored} (only GGML_HEXAGON_*)" if ignored else ""
+    if not _npu_step(state, "registry", bool(name), f"{NPU_BACKEND} registered, {count} device(s): {name}{note}"
+                     if name else f"{NPU_BACKEND} registered without a device{note}"):
+        return
+    state["device"] = name
+    try:
+        check = getattr(ctypes.CDLL(path, mode=getattr(ctypes, "RTLD_LOCAL", 0)), "glossarion_hexagon_session_check")
+    except (OSError, AttributeError):
+        _npu_step(state, "session", False, "not checked: this build has no session check")
+        return
+    check.restype = ctypes.c_int
+    check.argtypes = [ctypes.c_size_t, ctypes.c_char_p, ctypes.c_size_t]
