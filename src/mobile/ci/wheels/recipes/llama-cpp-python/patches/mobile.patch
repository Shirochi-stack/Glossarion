+    cap = _Capability()
+    cap.domain, cap.attribute_ID, cap.capability = _CDSP_DOMAIN_ID, attribute, 0
+    err = int(remote_handle_control(_DSPRPC_GET_DSP_INFO, ctypes.byref(cap), ctypes.sizeof(cap)))
+    if err != 0:
+        return None, f"remote_handle_control(DSPRPC_GET_DSP_INFO) failed (error {err & 0xFFFFFFFF:#x})"
