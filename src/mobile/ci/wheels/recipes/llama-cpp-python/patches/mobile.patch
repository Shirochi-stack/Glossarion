 _EMSCRIPTEN_SIDE_MODULE_SUFFIX = ".cpython-00-wasm32-emscripten.so"
 
+# Glossarion: runtime CPU-variant selection (GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS).
+# The Android arm64 wheel ships one libggml-cpu-<variant>.so per feature set instead of
+# a single armv8.0 libggml-cpu.so. ggml's own ggml_backend_load_all() would scan the
+# executable's directory and the cwd, which on Android are /system/bin and / (the libs
+# live in the APK's jniLibs, usually not even extracted to disk), so the loader picks
+# the variant itself, by bare soname where no file exists:
+#   1. ask every variant for its ggml_backend_score() (the feature probe, compiled
+#      without the variant's -march flags; 0 = this CPU lacks a required feature),
+#   2. register the best one with ggml_backend_load(), which checks the score again.
+# A variant that needs dotprod / i8mm is never registered on a CPU without them, so
+# its code never runs there.
+#: Variants of the Android arm64 build, best first (vendor/llama.cpp/ggml/src/CMakeLists.txt).
+ANDROID_CPU_VARIANTS = (
+    "android_armv8.6_1",  # dotprod + fp16 + i8mm (Cortex-A510/A710/X2 and later)
+    "android_armv8.2_2",  # dotprod + fp16 (Cortex-A55/A75/A76/A77/A78/X1)
+    "android_armv8.2_1",  # dotprod
+    "android_armv8.0_1",  # baseline armv8.0 + NEON (Cortex-A53/A73): every arm64 device
+)
+#: The CPU backend this process registered: a variant name, "builtin" (libggml links the
+#: CPU backend itself: x86_64, iOS, desktop builds) or "none"; None before the first load.
+CPU_BACKEND_VARIANT: Optional[str] = None
+
+
+def _variant_of(name: str) -> str:
+    stem = os.path.basename(name)
+    for suffix in (".so", ".dylib", ".dll"):
+        if stem.endswith(suffix):
+            stem = stem[: -len(suffix)]
+    for prefix in ("libggml-cpu-", "ggml-cpu-"):
+        if stem.startswith(prefix):
+            return stem[len(prefix):]
+    return stem
+
+
+def _cpu_variant_candidates(base_path: pathlib.Path) -> List[str]:
+    """The variant libraries to probe: the files next to libggml (desktop, legacy-extracted
+    jniLibs) and, by bare soname, the Android arm64 build's list."""
+    out: List[str] = []
+    try:
+        if base_path.is_dir():
+            out += [str(p) for p in sorted(base_path.glob("libggml-cpu-*.so"))]
+    except OSError:
+        pass
+    on_disk = {_variant_of(p) for p in out}
+    out += [f"libggml-cpu-{v}.so" for v in ANDROID_CPU_VARIANTS if v not in on_disk]
+    return out
+
+
+def _probe_score(name: str) -> int:
+    """ggml_backend_score() of one variant library (0 when it does not load or lacks it)."""
+    try:
+        lib = ctypes.CDLL(name, mode=getattr(ctypes, "RTLD_LOCAL", 0))
+    except OSError:
+        return 0
+    try:
+        fn = lib.ggml_backend_score
+        fn.restype = ctypes.c_int
+        fn.argtypes = []
+        return int(fn())
+    except AttributeError:
+        return 0
+    finally:
+        # unmap the probed copy again; ggml_backend_load() reopens the chosen one
+        try:
+            import _ctypes
+
+            _ctypes.dlclose(lib._handle)  # type: ignore[attr-defined]
+        except Exception:
+            pass
+
+
+def register_cpu_backend(libggml, base_path: pathlib.Path) -> Optional[str]:
+    """Register the best CPU backend variant with ggml (once per process); returns its name.
+
+    Environment: LLAMA_CPP_CPU_VARIANT=<variant> tries that variant first (ggml still
+    refuses it when the CPU lacks one of its features)."""
+    global CPU_BACKEND_VARIANT
+    if CPU_BACKEND_VARIANT is not None:
+        return CPU_BACKEND_VARIANT
+    try:
+        reg_count = libggml.ggml_backend_reg_count
+        load = libggml.ggml_backend_load
+    except AttributeError:
+        return None
+    reg_count.restype = ctypes.c_size_t
+    reg_count.argtypes = []
+    load.restype = ctypes.c_void_p
+    load.argtypes = [ctypes.c_char_p]
+    if reg_count() > 0:
+        CPU_BACKEND_VARIANT = "builtin"  # no GGML_BACKEND_DL: the CPU backend is linked in
+        return CPU_BACKEND_VARIANT
+    candidates = _cpu_variant_candidates(base_path)
+    scored = []
+    for order, name in enumerate(candidates):
+        score = _probe_score(name)
+        if score > 0:
+            scored.append((-score, order, name))
+    ranked = [name for _s, _o, name in sorted(scored)]
+    forced = os.environ.get("LLAMA_CPP_CPU_VARIANT", "").strip()
+    if forced:
+        ranked = [n for n in ranked if _variant_of(n) == forced] + [n for n in ranked if _variant_of(n) != forced]
+    for name in ranked:
+        if load(name.encode("utf-8")):
+            CPU_BACKEND_VARIANT = _variant_of(name)
+            return CPU_BACKEND_VARIANT
+    # A GGML_BACKEND_DL build without variants ships a plain libggml-cpu.so.
+    for name in ([str(base_path / "libggml-cpu.so")] if (base_path / "libggml-cpu.so").exists() else []) + ["libggml-cpu.so"]:
+        if load(name.encode("utf-8")):
+            CPU_BACKEND_VARIANT = "default"
+            return CPU_BACKEND_VARIANT
+    CPU_BACKEND_VARIANT = "none"  # llama_backend_init() falls back to ggml_backend_load_all()
+    return CPU_BACKEND_VARIANT
+
 
