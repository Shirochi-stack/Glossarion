+_DEV_PROPS: list = []
+# enum ggml_backend_dev_type (ggml-backend.h at the pin)
+_DEV_CPU, _DEV_GPU, _DEV_IGPU, _DEV_ACCEL, _DEV_META = 0, 1, 2, 3, 4
