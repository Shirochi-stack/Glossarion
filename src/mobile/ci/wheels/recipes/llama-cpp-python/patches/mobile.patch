+def device_index(name: str) -> int:
+    """The main_gpu that puts a split_mode NONE model on the registered backend whose registry name is
+    ``name`` ("HTP", "OpenCL"); -1 when it is not registered. Repeats llama.cpp's default device list
+    (vendor/llama.cpp/src/llama.cpp, llama_prepare_model_devices, at the pin) over ggml's devices in
+    registration order:
+        case GGML_BACKEND_DEVICE_TYPE_CPU:
+        case GGML_BACKEND_DEVICE_TYPE_ACCEL:
+            // skip CPU backends since they are handled separately
+        case GGML_BACKEND_DEVICE_TYPE_GPU: {
+            ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+            if (ggml_backend_reg_name(reg) == std::string("RPC")) {
+                rpc_servers.push_back({false, dev});
+            } else {
+                // check if there is already a GPU with the same device id
+                ... if (props.device_id && d_props.device_id) { return strcmp(props.device_id, d_props.device_id) == 0; }
+                ... gpus.push_back({false, dev});
+        case GGML_BACKEND_DEVICE_TYPE_IGPU:
+            if (igpus.empty() || ggml_backend_dev_backend_reg(dev) == ggml_backend_dev_backend_reg(igpus.back().dev)) {
+                igpus.push_back({false, dev});
+        model->devices.insert(model->devices.begin(), rpc_servers.begin(), rpc_servers.end());
+        model->devices.insert(model->devices.end(), gpus.begin(), gpus.end());
+        if (gpus.empty()) {
+            model->devices.insert(model->devices.end(), igpus.begin(), igpus.end());
+    then main_gpu indexes model->devices."""
+    if _LIBGGML is None:
+        return -1
+    try:
+        props_type = _device_props_type()
+        count = _ggml("ggml_backend_dev_count", ctypes.c_size_t, [])
+        get = _ggml("ggml_backend_dev_get", ctypes.c_void_p, [ctypes.c_size_t])
+        dev_type = _ggml("ggml_backend_dev_type", ctypes.c_int, [ctypes.c_void_p])
+        dev_reg = _ggml("ggml_backend_dev_backend_reg", ctypes.c_void_p, [ctypes.c_void_p])
+        reg_name = _ggml("ggml_backend_reg_name", ctypes.c_char_p, [ctypes.c_void_p])
+        get_props = _ggml("ggml_backend_dev_get_props", None, [ctypes.c_void_p, ctypes.POINTER(props_type)])
+        rpc_servers, gpus, igpus = [], [], []  # (registry, registry name, device id)
+        for i in range(int(count())):
+            dev = get(i)
+            kind = int(dev_type(dev))
+            reg = dev_reg(dev)
+            reg_label = (reg_name(reg) or b"").decode("utf-8", "replace")
+            if kind == _DEV_GPU:
+                if reg_label == "RPC":
+                    rpc_servers.append((reg, reg_label, None))
+                    continue
+                props = props_type()
+                get_props(dev, ctypes.byref(props))
+                device_id = props.device_id
+                if device_id and any(other and other == device_id for _r, _n, other in gpus):
+                    continue
+                gpus.append((reg, reg_label, device_id))
+            elif kind == _DEV_IGPU and (not igpus or reg == igpus[-1][0]):
+                igpus.append((reg, reg_label, None))
+        devices = rpc_servers + gpus + (igpus if not gpus else [])
+        return next((i for i, (_r, label, _d) in enumerate(devices) if label == name), -1)
+    except Exception:  # an older libggml without one of these: no answer rather than a wrong device
+        return -1
