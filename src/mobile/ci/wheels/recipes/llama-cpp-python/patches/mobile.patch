+                     else f"the cDSP reported arch value {value:#x}"):
+        return
+    state["arch"] = arch
+    copied, unchanged = _copy_skeletons(skeletons, skel_dir)
+    if not _npu_step(state, "skeletons", arch in skeletons,
+                     f"{HTP_PREFIX}{arch}.so in {skel_dir} ({copied} copied, {unchanged} up to date)"
