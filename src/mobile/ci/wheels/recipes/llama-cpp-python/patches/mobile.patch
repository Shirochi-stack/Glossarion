diff --git a/llama_cpp/_ctypes_extensions.py b/llama_cpp/_ctypes_extensions.py
index 02cee8a..81cf4a2 100644
--- a/llama_cpp/_ctypes_extensions.py
+++ b/llama_cpp/_ctypes_extensions.py
@@ -21,39 +21,589 @@ from typing_extensions import TypeAlias
 
 _EMSCRIPTEN_SIDE_MODULE_SUFFIX = ".cpython-00-wasm32-emscripten.so"
 
+# Glossarion: runtime CPU-variant selection (GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS).
+# The Android arm64 wheel ships one libggml-cpu-<variant>.so per feature set instead of
+# a single armv8.0 libggml-cpu.so. ggml's own ggml_backend_load_all() would scan the
+# executable's directory and the cwd, which on Android are /system/bin and / (the libs
+# live in the APK's jniLibs, usually not even extracted to disk), so the loader picks
+# the variant itself, by bare soname where no file exists:
+#   1. ask every variant for its ggml_backend_score() (the feature probe, compiled
+#      without the variant's -march flags; 0 = this CPU lacks a required feature),
+#   2. register the best one with ggml_backend_load(), which checks the score again.
+# A variant that needs dotprod / i8mm is never registered on a CPU without them, so
+# its code never runs there.
+#: Variants of the Android arm64 build, best first (vendor/llama.cpp/ggml/src/CMakeLists.txt).
+ANDROID_CPU_VARIANTS = (
+    "android_armv8.6_1",  # dotprod + fp16 + i8mm (Cortex-A510/A710/X2 and later)
+    "android_armv8.2_2",  # dotprod + fp16 (Cortex-A55/A75/A76/A77/A78/X1)
+    "android_armv8.2_1",  # dotprod
+    "android_armv8.0_1",  # baseline armv8.0 + NEON (Cortex-A53/A73): every arm64 device
+)
+#: The CPU backend this process registered: a variant name, "builtin" (libggml links the
+#: CPU backend itself: x86_64, iOS, desktop builds) or "none"; None before the first load.
+CPU_BACKEND_VARIANT: Optional[str] = None
+
+
+def _variant_of(name: str) -> str:
+    stem = os.path.basename(name)
+    for suffix in (".so", ".dylib", ".dll"):
+        if stem.endswith(suffix):
+            stem = stem[: -len(suffix)]
+    for prefix in ("libggml-cpu-", "ggml-cpu-"):
+        if stem.startswith(prefix):
+            return stem[len(prefix):]
+    return stem
+
+
+def _cpu_variant_candidates(base_path: pathlib.Path) -> List[str]:
+    """The variant libraries to probe: the files next to libggml (desktop, legacy-extracted
+    jniLibs) and, by bare soname, the Android arm64 build's list."""
+    out: List[str] = []
+    try:
+        if base_path.is_dir():
+            out += [str(p) for p in sorted(base_path.glob("libggml-cpu-*.so"))]
+    except OSError:
+        pass
+    on_disk = {_variant_of(p) for p in out}
+    out += [f"libggml-cpu-{v}.so" for v in ANDROID_CPU_VARIANTS if v not in on_disk]
+    return out
+
+
+def _probe_score(name: str) -> int:
+    """ggml_backend_score() of one variant library (0 when it does not load or lacks it)."""
+    try:
+        lib = ctypes.CDLL(name, mode=getattr(ctypes, "RTLD_LOCAL", 0))
+    except OSError:
+        return 0
+    try:
+        fn = lib.ggml_backend_score
+        fn.restype = ctypes.c_int
+        fn.argtypes = []
+        return int(fn())
+    except AttributeError:
+        return 0
+    finally:
+        # unmap the probed copy again; ggml_backend_load() reopens the chosen one
+        try:
+            import _ctypes
+
+            _ctypes.dlclose(lib._handle)  # type: ignore[attr-defined]
+        except Exception:
+            pass
+
+
+def register_cpu_backend(libggml, base_path: pathlib.Path) -> Optional[str]:
+    """Register the best CPU backend variant with ggml (once per process); returns its name.
+
+    Environment: LLAMA_CPP_CPU_VARIANT=<variant> tries that variant first (ggml still
+    refuses it when the CPU lacks one of its features)."""
+    global CPU_BACKEND_VARIANT
+    if CPU_BACKEND_VARIANT is not None:
+        return CPU_BACKEND_VARIANT
+    try:
+        reg_count = libggml.ggml_backend_reg_count
+        load = libggml.ggml_backend_load
+    except AttributeError:
+        return None
+    reg_count.restype = ctypes.c_size_t
+    reg_count.argtypes = []
+    load.restype = ctypes.c_void_p
+    load.argtypes = [ctypes.c_char_p]
+    if reg_count() > 0:
+        CPU_BACKEND_VARIANT = "builtin"  # no GGML_BACKEND_DL: the CPU backend is linked in
+        return CPU_BACKEND_VARIANT
+    candidates = _cpu_variant_candidates(base_path)
+    scored = []
+    for order, name in enumerate(candidates):
+        score = _probe_score(name)
+        if score > 0:
+            scored.append((-score, order, name))
+    ranked = [name for _s, _o, name in sorted(scored)]
+    forced = os.environ.get("LLAMA_CPP_CPU_VARIANT", "").strip()
+    if forced:
+        ranked = [n for n in ranked if _variant_of(n) == forced] + [n for n in ranked if _variant_of(n) != forced]
+    for name in ranked:
+        if load(name.encode("utf-8")):
+            CPU_BACKEND_VARIANT = _variant_of(name)
+            return CPU_BACKEND_VARIANT
+    # A GGML_BACKEND_DL build without variants ships a plain libggml-cpu.so.
+    for name in ([str(base_path / "libggml-cpu.so")] if (base_path / "libggml-cpu.so").exists() else []) + ["libggml-cpu.so"]:
+        if load(name.encode("utf-8")):
+            CPU_BACKEND_VARIANT = "default"
+            return CPU_BACKEND_VARIANT
+    CPU_BACKEND_VARIANT = "none"  # llama_backend_init() falls back to ggml_backend_load_all()
+    return CPU_BACKEND_VARIANT
+
+
+# Glossarion: optional GPU backend, registered on demand only (the app's "Use GPU" setting).
+#   * Android arm64: libggml-opencl.so (GGML_OPENCL + the Adreno kernels, a GGML_BACKEND_DL
+#     module next to the CPU variants). It alone needs the vendor's libOpenCL.so, so nothing
+#     else breaks on a phone without OpenCL: ggml_backend_load() just fails.
+#   * iOS: libggml-metal.dylib (GGML_METAL, embedded shader source), linked into libggml but
+#     no longer registered when the registry starts (patched ggml-backend-reg.cpp): Metal's
+#     device setup (and its shader compilation) runs only in register_gpu_backend().
+# A registered backend stays for the process; the CPU path then keeps llama.cpp off it with
+# split_mode NONE + main_gpu -1 (no offload device at all).
+#: {"backend", "device", "error"} after register_gpu_backend(); {} before.
+GPU_STATE: dict = {}
+_LIBGGML = None
+_LIBGGML_METAL = None
+_BASE_PATH: Optional[pathlib.Path] = None
+
+
+def _beside_libggml(soname: str) -> bool:
+    """A backend module is a file next to libggml (desktop, legacy-extracted jniLibs)."""
+    base = _BASE_PATH
+    if base is None:
+        return False
+    try:
+        return (base / soname).exists()
+    except OSError:
+        return False
+
+
+def _android_arm64() -> bool:
+    """Android arm64: the build whose optional backend modules sit in the APK's jniLibs."""
+    if sys.platform == "android" or hasattr(sys, "getandroidapilevel"):
+        import platform as _platform
+
+        return _platform.machine().lower() in ("aarch64", "arm64")
+    return False
+
+
+def gpu_backend_name() -> Optional[str]:
+    """The GPU backend this build ships ("Metal", "OpenCL") or None; loads nothing."""
+    if _LIBGGML_METAL is not None:
+        return "Metal"
+    if _beside_libggml("libggml-opencl.so"):
+        return "OpenCL"
+    if _android_arm64():
+        return "OpenCL"  # the arm64 wheel's libggml-opencl.so sits in the APK's jniLibs
+    return None
+
+
+def _ggml(name: str, restype, argtypes):
+    fn = getattr(_LIBGGML, name)
+    fn.restype = restype
+    fn.argtypes = argtypes
+    return fn
+
+
+def _load_backend(soname: str):
+    """ggml_backend_load() of one optional GGML_BACKEND_DL module (the file next to libggml, else the bare
+    soname: the APK's jniLibs): (registry or None, the path it loaded, why it did not load or None)."""
+    path = str(_BASE_PATH / soname) if _beside_libggml(soname) else soname
+    reg = _ggml("ggml_backend_load", ctypes.c_void_p, [ctypes.c_char_p])(path.encode("utf-8"))
+    if reg:
+        return reg, path, None
+    # ggml only logs dlerror(); load it once more to say why
+    try:
+        ctypes.CDLL(path, mode=getattr(ctypes, "RTLD_LOCAL", 0))
+        return None, path, None
+    except OSError as exc:
+        return None, path, str(exc).strip() or "the backend did not load"
+
+
+def _gpu_devices(reg) -> List[str]:
+    """Descriptions of the GPU devices of backend registry ``reg``."""
+    count = _ggml("ggml_backend_reg_dev_count", ctypes.c_size_t, [ctypes.c_void_p])
+    get = _ggml("ggml_backend_reg_dev_get", ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_size_t])
+    desc = _ggml("ggml_backend_dev_description", ctypes.c_char_p, [ctypes.c_void_p])
+    memory = _ggml("ggml_backend_dev_memory", None,
+                   [ctypes.c_void_p, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.c_size_t)])
+    out = []
+    for i in range(int(count(reg))):
+        dev = get(reg, i)
+        free, total = ctypes.c_size_t(0), ctypes.c_size_t(0)
+        memory(dev, ctypes.byref(free), ctypes.byref(total))
+        text = (desc(dev) or b"").decode("utf-8", "replace").strip()
+        if text and total.value:  # Metal keeps a device without an MTLDevice: no name, no memory
+            out.append(text)
+    return out
+
+
+def register_gpu_backend() -> dict:
+    """Register this build's GPU backend with ggml (once per process; later calls return the
+    first result): {"backend": "OpenCL"|"Metal"|None, "device": description or None,
+    "error": why there is no usable GPU, or None}."""
+    if GPU_STATE:
+        return dict(GPU_STATE)
+    name = gpu_backend_name()
+    state = {"backend": name, "device": None, "error": None}
+    try:
+        if _LIBGGML is None:
+            state["error"] = "the engine's libraries are not loaded"
+        elif name is None:
+            state["error"] = "this build has no GPU backend"
+        elif name == "Metal":
+            fn = getattr(_LIBGGML_METAL, "ggml_backend_metal_reg")
+            fn.restype = ctypes.c_void_p
+            fn.argtypes = []
+            reg = fn()
+            if not reg:
+                state["error"] = "Metal backend did not start"
+            else:
+                _ggml("ggml_backend_register", None, [ctypes.c_void_p])(reg)
+                devices = _gpu_devices(reg)
+                if devices:
+                    state["device"] = devices[0]
+                else:
+                    state["error"] = "Metal found no usable GPU"
+        else:
+            reg, _path, why = _load_backend("libggml-opencl.so")
+            if not reg:
+                # usually no libOpenCL.so on the phone
+                state["error"] = f"no OpenCL driver ({why or 'the OpenCL backend did not register'})"
+            else:
+                devices = _gpu_devices(reg)
+                if devices:
+                    state["device"] = devices[0]
+                else:
+                    state["error"] = ("no supported GPU: llama.cpp's OpenCL backend runs on Qualcomm Adreno "
+                                      "GPUs only (OpenCL 2.0+, FP16)")
+    except Exception as exc:  # a missing symbol, a bad handle: report, never raise into the app
+        state["error"] = f"{type(exc).__name__}: {exc}"
+    GPU_STATE.update(state)
+    return dict(GPU_STATE)
+
+
+# Glossarion: optional NPU backend (Qualcomm Hexagon HTP, ggml-hexagon), registered on demand only (the
+# app's NPU check), the third backend next to the CPU variants and the GPU above:
+#   * Android arm64: libggml-hexagon.so, a GGML_BACKEND_DL module in the APK's jniLibs. It dlopens the
+#     vendor's libcdsprpc.so itself (never NEEDED), so a phone without FastRPC just gets an error.
+#   * The HTP skeletons (libggml-htp-vNN.so: Hexagon DSP code the cDSP loads through FastRPC, one per
+#     HTP arch) ship as package data llama_cpp/htp/libggml-htp-vNN.so.dsp, inside the APK's
+#     sitepackages.zip; FastRPC needs a real directory, so register_npu_backend() copies them out.
+#   * ggml-hexagon reads GGML_HEXAGON_* once, when its registry starts (htpdrv_init() then answers
+#     "Driver already loaded"), so the environment is set before the only load, which happens here and
+#     never through ggml_backend_load_all() (that one would load "hexagon" too).
+#   * Its arch query falls back to v73 without a word when it fails; ours runs first and decides, and
+#     GGML_HEXAGON_ARCH carries the answer.
+#: {"backend", "device", "arch", "error", "steps"} after register_npu_backend(); {} before.
+NPU_STATE: dict = {}
+NPU_BACKEND = "HTP"  # ggml-hexagon's registry name
+NPU_LIBRARY = "libggml-hexagon.so"
+NPU_STEPS = ("shipped", "libcdsprpc", "arch", "skeletons", "registry", "session")
+HTP_PREFIX, HTP_SUFFIX = "libggml-htp-v", ".so.dsp"
+_HTP_SOURCE = None  # the directory standing in for llama_cpp/htp (tests); None: the package's own
+# FastRPC (remote.h of the Hexagon SDK; the same values in github.com/quic/fastrpc inc/remote.h), as
+# htp-drv.cpp's htpdrv_get_arch() asks: remote_handle_control(DSPRPC_GET_DSP_INFO, remote_dsp_capability)
+_DSPRPC_GET_DSP_INFO = 2  # enum handle_control_req_id
+_CDSP_DOMAIN_ID = 3
+_UNSIGNED_PD_SUPPORT, _ARCH_VER = 1, 6  # enum remote_dsp_attributes
+
+
+def _htp_source():
+    """llama_cpp/htp as a directory or importlib.resources Traversable (sitepackages.zip on Android)."""
+    if _HTP_SOURCE is not None:
+        return _HTP_SOURCE
+    try:
+        import importlib.resources
+
+        return importlib.resources.files(globals().get("__package__") or "llama_cpp") / "htp"
+    except Exception:
+        return None
+
+
+def _packaged_skeletons() -> dict:
+    """{arch: packaged file} of llama_cpp/htp/libggml-htp-vNN.so.dsp."""
+    source = _htp_source()
+    out = {}
+    try:
+        entries = list(source.iterdir()) if source is not None and source.is_dir() else []
+    except (OSError, ValueError):
+        entries = []
+    for entry in entries:
+        name = entry.name
+        digits = name[len(HTP_PREFIX):-len(HTP_SUFFIX)] if name.startswith(HTP_PREFIX) and name.endswith(HTP_SUFFIX) \
+            else ""
+        if digits.isdigit():
+            out[int(digits)] = entry
+    return out
+
+
+def npu_backend_shipped() -> bool:
+    """This wheel carries the NPU backend: the HTP skeletons in the package and libggml-hexagon (next to
+    libggml, or in the APK's jniLibs on Android arm64). Loads nothing."""
+    return bool(_packaged_skeletons()) and (_beside_libggml(NPU_LIBRARY) or _android_arm64())
+
+
+def _npu_step(state: dict, name: str, ok: bool, detail: str) -> bool:
+    state["steps"].append({"name": name, "ok": bool(ok), "detail": str(detail)})
+    if not ok and not state["error"]:
+        state["error"] = str(detail)
+    return bool(ok)
+
+
+def _dsp_info(remote_handle_control, attribute: int):
+    """(capability, None) or (None, why) of one DSPRPC_GET_DSP_INFO query on the cDSP."""
+
