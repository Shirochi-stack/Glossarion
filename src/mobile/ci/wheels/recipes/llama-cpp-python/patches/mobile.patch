+def register_npu_backend(skel_dir, options=None) -> dict:
+    """Register the Hexagon NPU backend with ggml (once per process; later calls return the first result,
+    because ggml-hexagon reads its environment only once). Never raises. ``skel_dir``: a writable
+    directory the HTP skeletons are copied to; ``options``: {GGML_HEXAGON_* name: value} set before the
+    load. Returns {"backend": "HTP", "device": "HTP0" or "", "arch": int or None, "error": "" or why,
+    "steps": [{"name", "ok", "detail"}]} with one entry per NPU_STEPS name, in order; the steps after the
+    first failure are "not checked"."""
+    if not NPU_STATE:
+        state = {"backend": NPU_BACKEND, "device": "", "arch": None, "error": "", "steps": []}
+        try:
+            _register_npu(state, skel_dir, dict(options or {}))
+        except Exception as exc:  # a missing symbol, an unwritable directory: report, never raise into the app
+            done = [s["name"] for s in state["steps"]]
+            _npu_step(state, next((n for n in NPU_STEPS if n not in done), NPU_STEPS[-1]), False,
+                      f"{type(exc).__name__}: {exc}")
+        done = {s["name"] for s in state["steps"]}
+        state["steps"] += [{"name": n, "ok": False, "detail": "not checked (an earlier step failed)"}
+                           for n in NPU_STEPS if n not in done]
+        NPU_STATE.update(state)
+    return {**NPU_STATE, "steps": [dict(s) for s in NPU_STATE["steps"]]}
+
