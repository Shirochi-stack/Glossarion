{
  "manifest_version": 3,
  "name": "Glossarion Arena Browser Companion",
  "version": "1.0.0",
  "description": "Connect your current Arena browser session to Glossarion.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://arena.ai/*", "http://127.0.0.1:18874/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1:18874/connect*"],
    "js": ["connect.js"],
    "run_at": "document_idle"
  }]
}
